# Production settings for deploy/docker-compose.prod.yml. Copy to deploy/.env (never committed).

# Public address. Baked into the build, so rebuild after changing it.
SITE_URL=https://shahadathossain.site

# Password for /admin. Use 12+ characters. Changing it signs everyone out.
ADMIN_PASSWORD=

# Random string of 32+ characters that signs admin sessions: `openssl rand -base64 32`
SESSION_SECRET=

# Password for the site's own Postgres. Letters and digits only (it goes into a URL): `openssl rand -hex 24`
POSTGRES_PASSWORD=
