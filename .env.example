# Postgres connection string. Locally: `npm run db:up` starts one on port 5433.
DATABASE_URL=postgres://portfolio:portfolio@127.0.0.1:5433/portfolio

# Password for /admin. Use 12+ characters.
ADMIN_PASSWORD=

# Random string (32+ characters) used to sign admin sessions: `openssl rand -base64 32`
SESSION_SECRET=

# Public URL of the site, used for canonical links, the sitemap and social previews.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
