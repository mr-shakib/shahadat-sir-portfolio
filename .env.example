# Postgres connection string. Locally: `npm run db:up` starts one on port 5433.
# On Vercel, connecting a Neon database sets DATABASE_URL for you (POSTGRES_URL also works).
DATABASE_URL=postgres://portfolio:portfolio@127.0.0.1:5433/portfolio

# Password for /admin. Use 12+ characters.
ADMIN_PASSWORD=

# Random string (32+ characters) used to sign admin sessions: `openssl rand -base64 32`
SESSION_SECRET=

# Public URL of the site, for canonical links, the sitemap and social previews.
# On Vercel it defaults to the production domain; set it when you use a custom domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. Set automatically when a Vercel Blob store is connected to the project.
# Admin uploads then go to Blob (up to 50 MB); without it they are stored in the database.
# BLOB_READ_WRITE_TOKEN=
